# --- Core ---
PORT=4000
DATABASE_URL=postgres://fieldbook:fieldbook@localhost:5432/fieldbook
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the app (used in email/SMS links)
APP_URL=http://localhost:5173

# --- Twilio (SMS) — leave blank to disable SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- SendGrid (Email) — leave blank to disable email ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
